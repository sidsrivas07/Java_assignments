import java.util.*;

class Course {
    private final String code;
    private final String name;
    private final int capacity;
    private final Set<String> enrolledStudents = new HashSet<>();
    private final List<String> prerequisites = new ArrayList<>();
    private final LinkedList<String> waitlist = new LinkedList<>();

    public Course(String code, String name, int capacity, List<String> prerequisites) {
        this.code = code;
        this.name = name;
        this.capacity = capacity;
        if (prerequisites != null) {
            this.prerequisites.addAll(prerequisites);
        }
    }

    public String getCode() { return code; }
    public String getName() { return name; }
    public int getCapacity() { return capacity; }
    public Set<String> getEnrolledStudents() { return enrolledStudents; }
    public List<String> getPrerequisites() { return prerequisites; }
    public LinkedList<String> getWaitlist() { return waitlist; }

    public boolean isFull() {
        return enrolledStudents.size() >= capacity;
    }

    @Override
    public String toString() {
        return String.format("%s (%s) | Enrolled: %d/%d | Waitlist: %d | Prereqs: %s",
                code, name, enrolledStudents.size(), capacity, waitlist.size(), prerequisites);
    }
}

class RegistrationPortal {
    private final Map<String, Course> courses = new HashMap<>();
    // Tracks completed courses per student for prerequisite checks
    private final Map<String, Set<String>> completedCourses = new HashMap<>();

    public void addCourse(Course course) {
        courses.put(course.getCode(), course);
    }

    public Course getCourse(String code) {
        return courses.get(code);
    }

    public void addCompletedCourse(String studentId, String courseCode) {
        completedCourses.computeIfAbsent(studentId, k -> new HashSet<>()).add(courseCode);
    }

    private boolean hasPrerequisites(String studentId, Course course) {
        Set<String> done = completedCourses.getOrDefault(studentId, Collections.emptySet());
        for (String prereq : course.getPrerequisites()) {
            if (!done.contains(prereq)) {
                return false;
            }
        }
        return true;
    }

    public String register(String studentId, String courseCode) {
        Course course = courses.get(courseCode);
        if (course == null) {
            return "FAILED: Course " + courseCode + " not found.";
        }
        if (course.getEnrolledStudents().contains(studentId)) {
            return "FAILED: " + studentId + " is already enrolled in " + courseCode + ".";
        }
        if (course.getWaitlist().contains(studentId)) {
            return "FAILED: " + studentId + " is already on the waitlist for " + courseCode + ".";
        }
        if (!hasPrerequisites(studentId, course)) {
            return "FAILED: " + studentId + " has not met prerequisites " + course.getPrerequisites() + ".";
        }
        if (!course.isFull()) {
            course.getEnrolledStudents().add(studentId);
            return "SUCCESS: " + studentId + " enrolled in " + courseCode + ".";
        }
        course.getWaitlist().addLast(studentId);
        return "WAITLISTED: " + courseCode + " is full. " + studentId
                + " is at position " + course.getWaitlist().size() + ".";
    }

    public String drop(String studentId, String courseCode) {
        Course course = courses.get(courseCode);
        if (course == null) {
            return "FAILED: Course " + courseCode + " not found.";
        }
        if (course.getEnrolledStudents().remove(studentId)) {
            String msg = "DROPPED: " + studentId + " dropped " + courseCode + ".";
            String promoted = promoteFromWaitlist(course);
            if (promoted != null) {
                msg += " | PROMOTED: " + promoted + " moved from waitlist to enrolled.";
            }
            return msg;
        }
        if (course.getWaitlist().remove(studentId)) {
            return "REMOVED: " + studentId + " removed from waitlist of " + courseCode + ".";
        }
        return "FAILED: " + studentId + " is not enrolled or waitlisted in " + courseCode + ".";
    }

    // Automated promotion: first-come, first-served
    private String promoteFromWaitlist(Course course) {
        while (!course.isFull() && !course.getWaitlist().isEmpty()) {
            String next = course.getWaitlist().pollFirst();
            if (hasPrerequisites(next, course)) {
                course.getEnrolledStudents().add(next);
                return next;
            }
        }
        return null;
    }

    public void displayAll() {
        for (Course c : courses.values()) {
            System.out.println(c);
        }
    }
}

public class CourseRegistrationPortal {
    public static void main(String[] args) {
        RegistrationPortal portal = new RegistrationPortal();

        portal.addCourse(new Course("CS101", "Intro to Programming", 2, null));
        portal.addCourse(new Course("CS201", "Data Structures", 2, Arrays.asList("CS101")));
        portal.addCourse(new Course("CS301", "Algorithms", 1, Arrays.asList("CS101", "CS201")));

        portal.addCompletedCourse("S3", "CS101");
        portal.addCompletedCourse("S4", "CS101");
        portal.addCompletedCourse("S5", "CS101");
        portal.addCompletedCourse("S5", "CS201");
        portal.addCompletedCourse("S6", "CS101");
        portal.addCompletedCourse("S6", "CS201");

        System.out.println("--- Registrations ---");
        System.out.println(portal.register("S1", "CS101"));
        System.out.println(portal.register("S2", "CS101"));
        System.out.println(portal.register("S3", "CS101")); // waitlisted
        System.out.println(portal.register("S1", "CS101")); // duplicate
        System.out.println(portal.register("S1", "CS201")); // prereq fail
        System.out.println(portal.register("S3", "CS201"));
        System.out.println(portal.register("S4", "CS201"));
        System.out.println(portal.register("S5", "CS201")); // waitlisted
        System.out.println(portal.register("S5", "CS301"));
        System.out.println(portal.register("S6", "CS301")); // waitlisted
        System.out.println(portal.register("S9", "CS999")); // not found

        System.out.println("\n--- State ---");
        portal.displayAll();

        System.out.println("\n--- Drops & Promotion ---");
        System.out.println(portal.drop("S1", "CS101"));  // S3 promoted
        System.out.println(portal.drop("S5", "CS301"));  // S6 promoted
        System.out.println(portal.drop("S6", "CS201"));  // not enrolled

        System.out.println("\n--- Final State ---");
        portal.displayAll();
    }
}

