import java.time.LocalDate;
import java.time.LocalTime;
import java.time.format.DateTimeFormatter;
import java.time.format.DateTimeParseException;
import java.time.temporal.ChronoUnit;
import java.util.Objects;
import java.util.Optional;
import java.util.Scanner;

class Event {

    private final String name;
    private final LocalDate date;
    private final LocalTime startTime;
    private final Optional<String> venue;

    public Event(String name, LocalDate date, LocalTime startTime, String venue) {
        this.name = Objects.requireNonNull(name, "Event name must not be null");
        this.date = Objects.requireNonNull(date, "Event date must not be null");
        this.startTime = Objects.requireNonNull(startTime, "Start time must not be null");
        // 6. Optional venue (empty/blank venue becomes Optional.empty())
        this.venue = Optional.ofNullable(venue).filter(v -> !v.trim().isEmpty());
    }

    // 3. Check whether the event is in the future, today, or in the past
    public String getDateStatus() {
        LocalDate today = LocalDate.now();
        if (date.isAfter(today)) {
            return "Future event";
        } else if (date.isEqual(today)) {
            return "Event is today";
        } else {
            return "Past event";
        }
    }

    // 4. Days remaining until the event
    public long getDaysRemaining() {
        return ChronoUnit.DAYS.between(LocalDate.now(), date);
    }

    // 5. End time if event lasts two hours
    public LocalTime getEndTime() {
        return startTime.plusHours(2);
    }

    // 2. Display event details
    public void display() {
        DateTimeFormatter dateFmt = DateTimeFormatter.ofPattern("dd MMM yyyy (EEEE)");
        DateTimeFormatter timeFmt = DateTimeFormatter.ofPattern("hh:mm a");

        System.out.println("\n========== EVENT DETAILS ==========");
        System.out.println("Event Name : " + name);
        System.out.println("Date       : " + date.format(dateFmt));
        System.out.println("Start Time : " + startTime.format(timeFmt));
        System.out.println("End Time   : " + getEndTime().format(timeFmt) + " (2-hour duration)");
        System.out.println("Venue      : " + venue.orElse("Venue not specified"));
        System.out.println("Status     : " + getDateStatus());

        long days = getDaysRemaining();
        if (days > 0) {
            System.out.println("Days Left  : " + days + " day(s)");
        } else if (days == 0) {
            System.out.println("Days Left  : 0 (happening today)");
        } else {
            System.out.println("Days Ago   : " + Math.abs(days) + " day(s)");
        }
        System.out.println("===================================");
    }
}

public class EventManager {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        try {
            // 1. Accept event name, date, and start time
            System.out.print("Enter event name: ");
            String name = sc.nextLine();

            System.out.print("Enter event date (yyyy-MM-dd): ");
            LocalDate date = LocalDate.parse(sc.nextLine().trim());

            System.out.print("Enter start time (HH:mm, 24-hour): ");
            LocalTime time = LocalTime.parse(sc.nextLine().trim());

            System.out.print("Enter venue (press Enter to skip): ");
            String venue = sc.nextLine();

            Event event = new Event(name, date, time, venue);
            event.display();

        } catch (DateTimeParseException e) {
            System.out.println("Invalid date/time format: " + e.getMessage());
        } finally {
            sc.close();
        }
    }
}

