import java.util.Objects;
import java.util.Optional;

class Result<T extends Number> {

    private final String studentName;
    private final T[] marks;
    private final double maxMarksPerSubject;

    public Result(String studentName, T[] marks, double maxMarksPerSubject) {
        // 5. Validate required inputs using Objects.requireNonNull()
        this.studentName = Objects.requireNonNull(studentName, "Student name must not be null");
        this.marks = marks; // may be null/empty to demonstrate Optional handling
        if (maxMarksPerSubject <= 0) {
            throw new IllegalArgumentException("Max marks must be greater than zero");
        }
        this.maxMarksPerSubject = maxMarksPerSubject;
    }

    // 1 & 2. Calculate average using doubleValue()
    public double calculateAverage() {
        Objects.requireNonNull(marks, "Marks must not be null");
        if (marks.length == 0) {
            return 0.0;
        }
        double total = 0.0;
        for (T mark : marks) {
            total += Objects.requireNonNull(mark, "Individual mark must not be null").doubleValue();
        }
        return total / marks.length;
    }

    // 2. Calculate percentage
    public double calculatePercentage() {
        return (calculateAverage() / maxMarksPerSubject) * 100;
    }

    // 3. Determine pass/fail based on a threshold percentage
    public boolean hasPassed(double thresholdPercentage) {
        return calculatePercentage() >= thresholdPercentage;
    }

    // 4. Display result using Optional if marks are available
    public void displayResult(double thresholdPercentage) {
        Optional<T[]> marksOptional = Optional.ofNullable(marks)
                .filter(m -> m.length > 0);

        marksOptional.ifPresentOrElse(
                m -> {
                    System.out.println("Student    : " + studentName);
                    System.out.print("Marks      : ");
                    for (T mark : m) {
                        System.out.print(mark + " ");
                    }
                    System.out.println();
                    System.out.printf("Average    : %.2f%n", calculateAverage());
                    System.out.printf("Percentage : %.2f%%%n", calculatePercentage());
                    System.out.println("Status     : " + (hasPassed(thresholdPercentage) ? "PASS" : "FAIL"));
                },
                () -> {
                    System.out.println("Student    : " + studentName);
                    System.out.println("Marks are not available.");
                }
        );
        System.out.println("-----------------------------------");
    }
}

public class StudentResultDemo {

    public static void main(String[] args) {
        double threshold = 40.0;

        // Integer marks
        Integer[] intMarks = {78, 85, 90, 67, 72};
        Result<Integer> r1 = new Result<>("Alice", intMarks, 100);
        r1.displayResult(threshold);

        // Double marks
        Double[] doubleMarks = {35.5, 28.0, 41.5, 30.0};
        Result<Double> r2 = new Result<>("Bob", doubleMarks, 100);
        r2.displayResult(threshold);

        // Float marks
        Float[] floatMarks = {55.5f, 60.0f, 48.5f};
        Result<Float> r3 = new Result<>("Charlie", floatMarks, 100);
        r3.displayResult(threshold);

        // Marks not available (null)
        Result<Integer> r4 = new Result<>("Diana", null, 100);
        r4.displayResult(threshold);

        // requireNonNull validation: null student name
        try {
            new Result<Integer>(null, intMarks, 100);
        } catch (NullPointerException e) {
            System.out.println("Validation error: " + e.getMessage());
        }
    }
}

