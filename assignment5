import java.util.Optional;

public class StudentEmailOptional {

    public static void main(String[] args) {

        // 1. Create an Optional containing an email address
        Optional<String> emailOptional = Optional.of("student@example.com");

        // 2. Create an empty Optional
        Optional<String> emptyOptional = Optional.empty();

        // 3. Display the email using ifPresent()
        System.out.print("Email (using ifPresent): ");
        emailOptional.ifPresent(System.out::println);

        System.out.print("Empty Optional (using ifPresent): ");
        emptyOptional.ifPresent(System.out::println);
        System.out.println("(nothing printed, Optional is empty)");

        // 4. Use orElse() to provide a default email address
        String email1 = emailOptional.orElse("default@example.com");
        String email2 = emptyOptional.orElse("default@example.com");
        System.out.println("orElse with value present: " + email1);
        System.out.println("orElse with empty Optional: " + email2);

        // 5. Use orElseThrow() to handle a missing email value
        try {
            String email3 = emailOptional.orElseThrow(
                    () -> new IllegalArgumentException("Email is missing!"));
            System.out.println("orElseThrow with value present: " + email3);

            String email4 = emptyOptional.orElseThrow(
                    () -> new IllegalArgumentException("Email is missing!"));
            System.out.println("orElseThrow with empty Optional: " + email4);
        } catch (IllegalArgumentException e) {
            System.out.println("Exception caught: " + e.getMessage());
        }
    }
}

